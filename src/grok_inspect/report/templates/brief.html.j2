<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Grok Inspect Report</title>
  <style>
    :root { --bg:#0b1020; --card:#141b2d; --text:#e8eefc; --muted:#9aa8c7; --crit:#ff4d6d; --high:#ff8c42; --med:#ffd166; --low:#7bdff2; --info:#8d99ae; }
    body { font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 2rem; line-height: 1.5; }
    h1,h2,h3 { margin-top: 1.4rem; }
    .meta { color: var(--muted); margin-bottom: 1.5rem; }
    .card { background: var(--card); border-radius: 12px; padding: 1rem 1.25rem; margin: 0.75rem 0; border: 1px solid #243049; }
    .sev-critical { border-left: 4px solid var(--crit); }
    .sev-high { border-left: 4px solid var(--high); }
    .sev-medium { border-left: 4px solid var(--med); }
    .sev-low { border-left: 4px solid var(--low); }
    .sev-info { border-left: 4px solid var(--info); }
    code { background: #0f1524; padding: 0.1rem 0.35rem; border-radius: 4px; }
    ul { padding-left: 1.2rem; }
    footer { color: var(--muted); margin-top: 2rem; font-size: 0.9rem; }
  </style>
</head>
<body>
  <h1>Grok Inspect Report</h1>
  <div class="meta">
    <div><strong>Host:</strong> {{ result.host.get('hostname') }} ({{ result.host.get('os_family') }} {{ result.host.get('release') }})</div>
    <div><strong>Elevated:</strong> {{ result.elevated }}</div>
    <div><strong>Window:</strong> {{ result.started_at }} → {{ result.finished_at }}</div>
    <div><strong>Max severity:</strong> {{ result.score.max_severity.value }} · open findings: {{ result.score.open_finding_count }}</div>
    <div><strong>Tool:</strong> grok-inspect {{ result.tool_version }}</div>
  </div>

  <h2>Coverage</h2>
  <div class="card">
    <ul>
    {% for c in result.coverage %}
      <li><code>{{ c.collector }}</code>: <strong>{{ c.status.value }}</strong>{% if c.detail %} — {{ c.detail }}{% endif %}</li>
    {% endfor %}
    </ul>
  </div>

  <h2>Findings</h2>
  {% set open_f = result.findings | selectattr('acknowledged', 'equalto', false) | list %}
  {% if not open_f %}
    <div class="card">No open findings.</div>
  {% endif %}
  {% for f in open_f %}
    <div class="card sev-{{ f.severity.value }}">
      <h3>[{{ f.severity.value | upper }}] {{ f.title }}</h3>
      <div><code>{{ f.id }}</code> · {{ f.category }} · confidence {{ f.confidence }}</div>
      <p>{{ f.summary }}</p>
      {% if f.remediation_hint %}<p><em>Hint:</em> {{ f.remediation_hint }}</p>{% endif %}
    </div>
  {% endfor %}

  <h2>Grok Analysis</h2>
  <div class="card">
  {% if result.grok.available %}
    <p><strong>Model:</strong> {{ result.grok.model_id }} (reasoning_effort={{ result.grok.reasoning_effort }})</p>
    <h3>Executive summary</h3>
    <p>{{ result.grok.executive_summary }}</p>
    <h3>Threat narrative</h3>
    <p>{{ result.grok.threat_narrative }}</p>
    {% if result.grok.remediation_plan %}
    <h3>Remediation plan</h3>
    <ol>
      {% for step in result.grok.remediation_plan %}
      <li>{{ step }}</li>
      {% endfor %}
    </ol>
    {% endif %}
  {% else %}
    <p>Grok analysis unavailable: {{ result.grok.error or 'skipped / no API key' }}</p>
  {% endif %}
  </div>

  <footer>Generated by grok-inspect. Defensive inspection only. Protect this report — it may contain sensitive host metadata.</footer>
</body>
</html>
